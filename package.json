{
  "name": "dchub-mcp-server",
  "version": "2.12.8",
  "description": "DC Hub Intelligence MCP Server — Standalone Streamable HTTP",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "vitest run",
    "sync": "node scripts/sync-tools-manifest.mjs",
    "sync:fix": "node scripts/sync-tools-manifest.mjs --fix",
    "prepare": "node scripts/install-hooks.mjs 2>/dev/null || exit 0"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "express": "^4.21.2",
    "jose": "^6.2.3",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
