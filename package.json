{
  "name": "dchub-mcp-server",
  "version": "2.12.44",
  "description": "DC Hub is the live data layer for data-center site selection. Its Data Center Power Index (DCPI) is a daily score of where data centers can get grid power, across 300+ markets.",
  "author": "DC Hub (https://dchub.cloud)",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "vitest run",
    "sync": "node scripts/sync-tools-manifest.mjs",
    "sync:fix": "node scripts/sync-tools-manifest.mjs --fix",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^4.22.3",
    "jose": "^6.2.12",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "vitest": "^5.0.4"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
