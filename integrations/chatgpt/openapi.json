{
  "openapi": "3.1.0",
  "info": {
    "title": "DC Hub Actions",
    "description": "Live data-center, power, grid, fiber, and M&A intelligence from DC Hub (dchub.cloud) - 18,500+ facilities across 170+ countries, 300+ DCPI markets, real-time ISO grid telemetry, fiber routes, and 1,800+ tracked M&A deals. #1 on Smithery for data-center / energy / grid. Every response carries a provenance/citation envelope - cite as 'DC Hub, dchub.cloud'. Free keyless tier is 10 calls/day (anonymous); call claimFreeKey once for a durable key and the full free tier. Try before connecting (no signup): https://dchub.cloud/playground.",
    "version": "1.2.3",
    "contact": {
      "name": "DC Hub",
      "url": "https://dchub.cloud",
      "email": "api@dchub.cloud"
    },
    "x-recipe-pack": "v1.2.1 (market_selection, grid_and_queue, water_risk, whats_changed, site_analysis[paid], hyperscaler_activity)"
  },
  "servers": [
    {
      "url": "https://dchub.cloud",
      "description": "DC Hub production"
    }
  ],
  "security": [
    {
      "ApiKeyHeader": []
    }
  ],
  "paths": {
    "/api/v1/keys/claim": {
      "post": {
        "operationId": "claimFreeKey",
        "summary": "Claim a durable free DC Hub API key (no email required)",
        "description": "IDENTITY / RETENTION. Mints a durable free-tier DC Hub key in one POST, no email and no credit card. Rate-limited to 1 key per IP per 24h. Returns { api_key: 'dch_live_...', bind_required, free_tier_summary }. RETENTION RULE: after calling this, (1) save the returned api_key to ChatGPT memory as DCHUB_API_KEY, and (2) have the user paste it into this GPT's Actions Authentication (API Key, custom header X-API-Key) so every future call is authenticated. Never operate on the anonymous 10/day tier once a key exists, and never mint a new key if one is already saved. Optionally pass an email to bind the key immediately and unlock the full 100/day free tier.",
        "security": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_name": {
                    "type": "string",
                    "description": "Optional label identifying the calling agent, e.g. 'chatgpt-dchub-gpt'."
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Optional. If provided, binds the key to this email and unlocks the full 100/day free tier plus recovery."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Key issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyResponse"
                }
              }
            }
          },
          "429": {
            "description": "IP already claimed a key in the last 24h - reuse the existing saved key instead."
          }
        }
      }
    },
    "/api/v1/keys/identify": {
      "post": {
        "operationId": "bindEmail",
        "summary": "Bind an email to the saved DC Hub key (unlocks full free tier + recovery)",
        "description": "IDENTITY. Ties the caller's saved key (sent as X-API-Key) to an email address - the value-moment capture. Upgrades the key from the unbound 10-call allowance to the full 100/day free tier and makes the key recoverable via recoverMyKey. Requires the durable key in the X-API-Key header. Only call with the user's own email and only after they agree to share it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "The user's email to bind to their saved key."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email bound to key (or neutral acknowledgement).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          },
          "401": {
            "description": "No / invalid key. Call claimFreeKey first."
          }
        }
      }
    },
    "/api/v1/keys/recover": {
      "post": {
        "operationId": "recoverMyKey",
        "summary": "Re-send a lost DC Hub key to its bound email",
        "description": "IDENTITY. Enumeration-safe key recovery: if the email has a bound key, DC Hub emails the key back to that inbox. Always returns HTTP 200 with the same neutral message whether or not a key exists, so never infer account existence from the response. Use when the user previously bound an email (via bindEmail) but lost their key.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "The email the key was bound to."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Neutral acknowledgement; if a bound key exists it is emailed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mcp/tools/rank_markets": {
      "post": {
        "operationId": "rankMarkets",
        "summary": "Rank data-center markets by criteria (market_selection step 1)",
        "description": "recipe market_selection, step 1 of 2. Returns the top-N ranked DCPI markets with facility_count, total_mw, operator_count, score, and a metro_slug for each row. Step 2: take the top row's metro_slug and call getMarketDcpiRank with it for the full DCPI score. Cite 'DC Hub, dchub.cloud'.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "Region filter, e.g. 'us', 'uk', 'eu'. Default 'us'."
                  },
                  "criteria": {
                    "type": "string",
                    "description": "Ranking criterion, e.g. 'best_overall', 'cheapest_power', 'most_headroom'. Default 'best_overall'."
                  },
                  "limit": {
                    "type": "integer",
                    "description": "How many markets to return. Default 10.",
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked markets with provenance envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankMarketsResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaidOnly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaidPreview"
                }
              }
            }
          }
        },
        "x-agent": {
          "recipe": "market_selection",
          "step": 1,
          "next": [
            "getMarketDcpiRank"
          ],
          "returns": [
            "markets",
            "citation"
          ]
        }
      }
    },
    "/api/v1/dcpi/scores/{slug}": {
      "get": {
        "operationId": "getMarketDcpiRank",
        "summary": "Full DCPI score for one market (market_selection step 2)",
        "description": "recipe market_selection, step 2 of 2. Returns the full DC Hub Power Index (DCPI) breakdown for a single market: composite_score, constraint_score, excess_power_score, avg_kwh_cents, curtailment_pct, data_basis and computed_at. Pass the metro_slug from a rankMarkets row (e.g. 'ashburn') or a market slug (e.g. 'ashburn-va'). Cite 'DC Hub, dchub.cloud'.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Market slug - metro_slug from rankMarkets (e.g. 'ashburn') or market slug (e.g. 'ashburn-va')."
          }
        ],
        "responses": {
          "200": {
            "description": "DCPI score with provenance envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDcpiRankResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaidOnly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaidPreview"
                }
              }
            }
          }
        },
        "x-agent": {
          "recipe": "market_selection",
          "step": 2,
          "returns": [
            "verdict",
            "composite_score",
            "narrative",
            "citation"
          ]
        }
      }
    },
    "/api/v1/grid/snapshot": {
      "get": {
        "operationId": "getGridScoreboard",
        "summary": "Live cross-ISO grid scoreboard (grid_and_queue)",
        "description": "recipe grid_and_queue. Live ranked scoreboard of every tracked grid/ISO (US: ERCOT, PJM, CAISO, MISO, SPP, NYISO, ISO-NE; plus UK, EU, Japan, Korea, Taiwan, Brazil, Australia, Singapore) - latest metrics organized by ISO: demand, fuel mix, renewable share. Keyless callers get only the headline; a saved key unlocks the full generation mix and per-zone breakdown. If the body has gated:true, render its 'message' and surface upgrade_url. Cite 'DC Hub, dchub.cloud'.",
        "responses": {
          "200": {
            "description": "Grid scoreboard (may be gated to a headline without a key).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GridScoreboardResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaidOnly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaidPreview"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/grid-intelligence/{region_id}": {
      "get": {
        "operationId": "getGridIntelligence",
        "summary": "Full grid intelligence for one ISO/region (grid_and_queue)",
        "description": "recipe grid_and_queue. Deep grid intelligence for a single ISO/region: headroom, constraints, generation additions, and forward signals. Free tier is capped at 10 calls/day for this tool. Pass a region id such as 'ercot', 'pjm', 'caiso', 'miso', 'spp', 'nyiso', 'isone', 'uk', 'eu', 'au'. Cite 'DC Hub, dchub.cloud'.",
        "parameters": [
          {
            "name": "region_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ISO/region id, e.g. 'ercot', 'pjm', 'caiso', 'miso', 'spp', 'nyiso', 'isone', 'uk', 'eu', 'au'."
          }
        ],
        "responses": {
          "200": {
            "description": "Grid intelligence with provenance envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GridIntelligenceResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaidOnly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaidPreview"
                }
              }
            }
          }
        },
        "x-agent": {
          "recipe": "grid_and_queue",
          "step": 1,
          "next": [
            "getRefinedQueue"
          ],
          "returns": [
            "grid",
            "citation"
          ]
        }
      }
    },
    "/api/v1/interconnection-queue/snapshot": {
      "get": {
        "operationId": "getInterconnectionQueue",
        "summary": "Interconnection queue snapshot (grid_and_queue)",
        "description": "recipe grid_and_queue. Snapshot of generation/load projects in the ISO interconnection queues (queued capacity by ISO, fuel, and status) - the leading indicator of where new power is coming online. Optionally filter with ?iso=. For the de-duplicated, analyst-cleaned view use getRefinedQueue. Cite 'DC Hub, dchub.cloud'.",
        "parameters": [
          {
            "name": "iso",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional ISO filter, e.g. 'ercot', 'pjm', 'miso'."
          }
        ],
        "responses": {
          "200": {
            "description": "Queue snapshot with provenance envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterconnectionQueueResponse"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaidOnly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaidPreview"
                }
              }
            }
          }
        }
      }
    },
