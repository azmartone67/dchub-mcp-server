    },
    "/api/v1/fiber/intel": {
      "get": {
        "operationId": "getFiberIntel",
        "summary": "Dark / long-haul fiber intelligence for a state or area",
        "description": ". Fiber-route intelligence - long-haul and metro dark-fiber corridors, carriers, and route density for a state or bounding box. Free tier is capped at 10 calls/day for this tool; deeper detail is gated (surface 'message'/upgrade_url on 402 or gated bodies). Pass ?state= (e.g. 'VA') or ?bbox=w,s,e,n. Cite 'DC Hub, dchub.cloud'.",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "2-letter US state code, e.g. 'VA'."
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional viewport as 'west,south,east,north'."
          }
        ],
        "responses": {
