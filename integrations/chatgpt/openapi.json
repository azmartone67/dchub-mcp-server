          "402": {
            "$ref": "#/components/responses/PaidOnly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaidPreview"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/changes/since": {
      "get": {
        "operationId": "getChanges",
        "summary": "What changed since a timestamp (whats_changed)",
        "description": "recipe whats_changed. Returns only what is new/changed since a prior pull: DCPI market movers, new facilities, new pipeline, and new news counts, plus a 'generated_at' cursor. Cache generated_at and pass it back as ?since=<that value> next session to get just the deltas (if total_changes is 0 your last pull is still fresh). Cite 'DC Hub, dchub.cloud'.",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ISO timestamp from a prior response's generated_at, or a window like '7d'."
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            },
            "description": "Alternative to 'since': look back this many days."
          }
        ],
        "responses": {
          "200": {
            "description": "Delta feed with a generated_at cursor and provenance envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangesResponse"
                }
              }
            }
          }
        },
        "x-agent": {
          "recipe": "whats_changed",
          "step": 1,
          "returns": [
            "changes",
            "citation"
          ]
        }
      }
    },
