        "description": "recipe grid_and_queue. The refined interconnection queue: de-duplicated and normalized across ISOs so counts and MW are comparable market-to-market. Optionally filter with ?iso= and cap with ?limit=. Cite 'DC Hub, dchub.cloud'.",
        "parameters": [
          {
            "name": "iso",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional ISO filter."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "description": "Optional row cap."
          }
        ],
        "responses": {
          "200": {
            "description": "Refined queue with provenance envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefinedQueueResponse"
                }
