                }
              }
            }
          }
        },
        "x-agent": {
          "recipe": "site_analysis",
          "step": 1,
          "returns": [
            "site",
            "citation"
          ]
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Durable DC Hub key (format dch_live_*) from claimFreeKey. Configure in this GPT's Actions Authentication as API Key, header name X-API-Key. (DC Hub also accepts Authorization: Bearer <key>, but configure only ONE auth method in the GPT to avoid conflicts.)"
      }
    },
    "responses": {
      "PaidOnly": {
        "description": "Metered / paid-only depth. Body carries the human-facing upgrade message and a machine-actionable next step. Render 'human_message' or 'message' verbatim to the user and surface 'upgrade_url' / 'agent_action.url'. Do NOT fabricate the withheld data.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "gated": {
                  "type": "boolean"
                },
                "tier_required": {
                  "type": "string"
                },
                "message": {
                  "type": "string",
                  "description": "Human-facing explanation of what is gated (REST transport)."
                },
                "human_message": {
                  "type": "string",
                  "description": "Human-facing explanation (MCP transport field name)."
                },
                "upgrade_url": {
                  "type": "string",
                  "description": "One-click checkout: $10 one-time = 1,000 calls, or $9/mo Starter."
                },
                "enterprise_url": {
                  "type": "string"
                },
                "agent_action": {
                  "type": "object",
                  "description": "Machine-actionable next step, e.g. type=claim_free_key with the claim URL to call then retry.",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "method": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "then": {
